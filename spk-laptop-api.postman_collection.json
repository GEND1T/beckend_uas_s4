          "item": [
            {
              "name": "Submit SPK Recommendation Request",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"kebutuhan\": \"Gaming & Coding\",\n  \"budgetMin\": 10000000,\n  \"budgetMax\": 20000000,\n  \"weights\": [\n    { \"subCriteriaId\": 1, \"weight\": 0.40 },\n    { \"subCriteriaId\": 5, \"weight\": 0.35 },\n    { \"subCriteriaId\": 8, \"weight\": 0.25 }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/api/customer/spk/requests",
                "description": "Submits budget requirements and weight parameters. Calculations will process SAW, WP, and TOPSIS."
              },
              "response": []
            },
            {
              "name": "Get SPK Request History",
              "request": {
