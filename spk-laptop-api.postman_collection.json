  "item": [
    {
      "name": "1. Authentication",
      "description": "Endpoints for authentication (Staff Login, Customer Register, and Customer Login). Automatically saves JWT tokens.",
      "item": [
        {
          "name": "Staff Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Staff token auto-saved: \" + jsonData.data.token.substring(0, 15) + \"...\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@store.com\",\n  \"password\": \"securepassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/shared/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shared",
                "auth",
                "login"
              ]
            },
            "description": "Login endpoint for staff members (Superadmin or Store Admin)."
          },
          "response": []
        },
        {
          "name": "Customer Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Customer token auto-saved from Register: \" + jsonData.data.token.substring(0, 15) + \"...\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Customer\",\n  \"email\": \"jane@customer.com\",\n  \"password\": \"customerpassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
